generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum OrderSource {
  ONLINE
  OFFLINE
}

enum OrderStatus {
  DRAFT
  WAITING
  PREPARING
  READY
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PaymentMethod {
  DEMO_CARD
  DEMO_SBP
}

enum ProductKind {
  FOOD
  DRINK
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  birthDate    DateTime?
  gender       String?
  phone        String?
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  orders       Order[]
  sessions     Session[]

  @@index([createdAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String?
  price       Int
  available   Boolean     @default(true)
  kind        ProductKind @default(FOOD)
  category    String?
  groupKey    String?
  sizeLabel   String?
  sizeSort    Int?
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]

  @@index([available, category, sortOrder, sizeSort])
  @@index([groupKey])
}

model Order {
  id                String       @id @default(cuid())
  publicOrderNumber Int?
  publicOrderKey    String?      @unique
  source            OrderSource
  status            OrderStatus
  createdAt         DateTime     @default(now())
  confirmedAt       DateTime?
  readyAt           DateTime?
  cancelledAt       DateTime?
  businessDay       String?
  totalPrice        Int
  customerName      String?
  userId            String?
  user              User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  payment           Payment?
  items             OrderItem[]

  @@index([status, confirmedAt])
  @@index([businessDay, confirmedAt])
  @@index([userId, createdAt])
}

model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  productId           String?
  quantity            Int
  unitPriceSnapshot   Int
  productNameSnapshot String
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id          String        @id @default(cuid())
  orderId      String        @unique
  provider     String        @default("DEMO")
  method       PaymentMethod?
  status       PaymentStatus @default(PENDING)
  amount       Int
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  completedAt  DateTime?
  failedAt     DateTime?
  cancelledAt  DateTime?
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}
